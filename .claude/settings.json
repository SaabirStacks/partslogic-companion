{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm view *)",
      "Bash(npx expo *)",
      "Bash(npx expo-doctor*)",
      "Bash(npx jest*)",
      "Bash(npx tsc*)",
      "Bash(npx eas-cli *)",
      "Bash(npx eas-cli@latest *)",
      "Bash(node scripts/sync-partslogic.mjs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git branch -D*)"
    ]
  }
}
