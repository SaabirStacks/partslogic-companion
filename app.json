{
  "expo": {
    "name": "PartsLogic",
    "slug": "partslogic-mobile",
    "owner": "prodz",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f238837d-ceae-40c7-9950-4ed68ebccf3f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "partslogic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.eclipseautoparts.partslogic",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#154889",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.eclipseautoparts.partslogic"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E2E3DF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#121311",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "PartsLogic uses the camera to scan barcodes and bin labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f238837d-ceae-40c7-9950-4ed68ebccf3f"
      }
    }
  }
}
